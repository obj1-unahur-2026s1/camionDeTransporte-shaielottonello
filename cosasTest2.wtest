import camion2.*
import cosas2.*

describe "Test paquete, batería, contenedor y embalaje" {

  test "El contenedor pesa 960 si le metemos embalaje, bumblebee y residuos" {
    residuos.peso(30)
    embalaje.cambiarLoQueEnvuelve(residuos)
    contenedor.meterElementos([embalaje, residuos, bumblebee])
    assert.equals(30+30+800+100, contenedor.peso())
  }

}